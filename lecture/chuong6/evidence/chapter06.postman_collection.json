            "exec": [
              "pm.test('TC-01 HTTP 200',()=>pm.response.to.have.status(200));",
              "const j=pm.response.json();",
              "pm.test('TC-01 noi dung',()=>{pm.expect(j.success).to.eql(true);pm.expect(j.data.user.role).to.eql('ADMIN'); pm.expect(j.data.accessToken).to.be.a('string'); pm.expect(j.data.user).not.to.have.property('passwordHash'); pm.collectionVariables.set('admin',j.data.accessToken);});"
