{
  "info": {
    "_postman_id": "crowdfunding-api-v1",
    "name": "Crowdfunding Platform API - Module Auth",
    "description": "Bộ API kiểm thử hệ thống Crowdfunding Platform (Module Auth & Core)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "1. Đăng ký User (Donater)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testuser02@example.com\",\n  \"password\": \"Password123@\",\n  \"fullName\": \"Trần Thị Quyên Góp\",\n  \"role\": \"USER\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "2. Đăng ký Fundraiser (Gây quỹ)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"fundraiser02@example.com\",\n  \"password\": \"Password123@\",\n  \"fullName\": \"Tổ chức Cứu trợ Miền Trung\",\n  \"role\": \"FUNDRAISER\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "3. Đăng nhập (Auto Save Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response && response.data && response.data.accessToken) {",
                  "    pm.collectionVariables.set('accessToken', response.data.accessToken);",
                  "    console.log('Saved accessToken to collection variable');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testuser02@example.com\",\n  \"password\": \"Password123@\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "4. Lấy Profile Hiện Tại (/auth/me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        },
        {
          "name": "5. Đăng xuất",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "KYC & Nâng cấp Gây quỹ",
      "item": [
        {
          "name": "1. Nộp hồ sơ KYC (User xin làm Fundraiser)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idCardNumber\": \"079201008899\",\n  \"cardIssuedDate\": \"2022-05-15\",\n  \"cardIssuedPlace\": \"Cục Cảnh sát QLHC về TTXH\",\n  \"frontCardImage\": \"https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?w=800\",\n  \"backCardImage\": \"https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?w=800\",\n  \"portraitImage\": \"https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=800\",\n  \"supportingDocuments\": {\n    \"organizationName\": \"Quỹ Trẻ Em Vùng Cao\",\n    \"licenseNumber\": \"QĐ-1234/UBND\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/verifications/request",
              "host": ["{{baseUrl}}"],
              "path": ["verifications", "request"]
            }
          }
        },
        {
          "name": "2. Xem trạng thái hồ sơ của mình",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/verifications/my-status",
              "host": ["{{baseUrl}}"],
              "path": ["verifications", "my-status"]
            }
          }
        },
        {
          "name": "3. [ADMIN] Xem danh sách chờ duyệt",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/verifications/pending?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["verifications", "pending"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "4. [ADMIN] Duyệt hồ sơ (Tự nâng cấp lên FUNDRAISER)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"APPROVED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/verifications/:id/review",
              "host": ["{{baseUrl}}"],
              "path": ["verifications", ":id", "review"],
              "variable": [
                {
                  "key": "id",
                  "value": ""
                }
              ]
            }
          }
        },
        {
          "name": "5. [ADMIN] Từ chối hồ sơ kèm lý do",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"REJECTED\",\n  \"rejectionReason\": \"Ảnh chụp giấy tờ bị lóa sáng, không đọc được số CCCD.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/verifications/:id/review",
              "host": ["{{baseUrl}}"],
              "path": ["verifications", ":id", "review"],
              "variable": [
                {
                  "key": "id",
                  "value": ""
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
