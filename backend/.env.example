# ====================================================================
# BIẾN MÔI TRƯỜNG MẪU (BACKEND) - HỆ THỐNG GÂY QUỸ CỘNG ĐỒNG (CĐ09)
# ====================================================================

# 1. Ứng dụng
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

# 2. Cơ sở dữ liệu MySQL (Kết nối trực tiếp tới container MySQL)
# Cú pháp: mysql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?<OPTIONS>
DATABASE_URL="mysql://dbuser:dbpassword@localhost:3306/crowdfunding_db?charset=utf8mb4&timezone=Asia%2FHo_Chi_Minh"

# 3. Redis (Cache, Rate Limiting & Session)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL="redis://localhost:6379"

# 4. Bảo mật JWT & Session
JWT_SECRET=super_secret_jwt_key_crowdfunding_cd09_replace_in_prod
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=super_refresh_jwt_key_crowdfunding_cd09_replace_in_prod
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_SECRET=session_cookie_secret_long_secure_string_here

# 5. MinIO (Lưu trữ ảnh, chứng từ, tài liệu tương thích S3)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadminpassword
MINIO_BUCKET_NAME=crowdfunding-media

# 6. Cổng thanh toán (Sandbox Demo)
VNPAY_TMN_CODE=your_tmn_code
VNPAY_HASH_SECRET=your_hash_secret
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/payment/vnpay-return

MOMO_PARTNER_CODE=your_momo_partner_code
MOMO_ACCESS_KEY=your_momo_access_key
MOMO_SECRET_KEY=your_momo_secret_key
